# Copy this file to .env and adjust the values you need.
# The real .env file is git-ignored. This app only talks to the Ollama server
# configured below; it never falls back to a cloud API.

# --- Local Ollama server -------------------------------------------------
# Ollama listens on 127.0.0.1:11434 by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model selected at startup. Download it first, for example:
#   ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# Read/connection timeout in seconds. First loads can be slow.
OLLAMA_TIMEOUT=120

# --- Conversation defaults ----------------------------------------------
# Maximum number of user turns sent back to the model as context.
CHATBOT_HISTORY_LIMIT=30

# Maximum characters accepted in one user message.
CHATBOT_MAX_MESSAGE_LENGTH=8000

# Sampling temperature (0.0 = deterministic, 2.0 = very random).
CHATBOT_TEMPERATURE=0.7

# Maximum tokens generated in one reply.
CHATBOT_MAX_TOKENS=1024

# Default system prompt. Leave empty for no system message.
CHATBOT_SYSTEM_PROMPT=You are a helpful, accurate assistant. Answer clearly, use Markdown when it improves readability, and say when you are unsure instead of inventing facts.

# --- Storage and web server ---------------------------------------------
# SQLite database. It stays on this machine.
CHATBOT_DB_PATH=chatbot.db

# Gradio server bind address and port. Keep 127.0.0.1 for local-only access.
CHATBOT_UI_HOST=127.0.0.1
CHATBOT_UI_PORT=7860

# Set to true only if you intentionally want a public Gradio share link.
CHATBOT_UI_SHARE=false

# --- Legacy terminal chatbot (optional) ---------------------------------
# The original terminal interface still works with:
#   python main.py    or    python -m chatbot
# It has its own provider settings; see the "Legacy terminal chatbot"
# section of README.md. It is not used by app.py.
# CHATBOT_PROVIDER=offline
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
