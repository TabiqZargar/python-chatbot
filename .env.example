# Copy this file to .env and fill in the values you need.
# The real .env file is git-ignored — never commit your API keys.

# Which provider to use: "offline" (default, no key needed) or "openai" (any
# OpenAI-compatible endpoint: OpenAI, Ollama, LM Studio, vLLM, Requesty,..s
# Amazon Bedrock Gemma 4, ...).
CHATBOT_PROVIDER=offline

# --- Only needed for CHATBOT_PROVIDER=openai ---
# API key for the endpoint. Leave empty for local servers that don't need one.
OPENAI_API_KEY=

# Base URL of an OpenAI-compatible API. The default points at OpenAI;
# for a local model use e.g. http://localhost:11434/v1 (Ollama).
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name passed to the endpoint, e.g. gpt-4o-mini or llama3.
OPENAI_MODEL=gpt-4o-mini

# --- Using Google Gemini (optional) ---
# Gemini exposes an OpenAI-compatible endpoint, so it reuses the "openai"
# provider — no separate provider or SDK is needed. Uncomment and fill in:
# CHATBOT_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.5-flash
# API key from Google AI Studio (https://aistudio.google.com/apikey).
# GEMINI_API_KEY is an alias for OPENAI_API_KEY; if both are set,
# OPENAI_API_KEY wins.
# GEMINI_API_KEY=

# --- Using Google Gemma 4 on Amazon Bedrock (optional) ---
# Gemma 4 on Bedrock is served only on the bedrock-mantle endpoint behind an
# OpenAI-compatible API, so it reuses the "openai" provider — no boto3, AWS
# SDK, or extra package is needed. Use the /openai/v1 prefix (not /v1).
# Generate a Bedrock API key in the Amazon Bedrock console (Bedrock API keys)
# and enable model access for Gemma 4; put the key in OPENAI_API_KEY.
# IAM alternative: SigV4-signed HTTP requests are possible but not supported
# by this stdlib provider — use an API key.
# CHATBOT_PROVIDER=openai
# OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
# OPENAI_MODEL=google.gemma-4-31b
# OPENAI_API_KEY=your-bedrock-api-key

# --- Using Requesty (optional) ---
# Requesty is an OpenAI-compatible router (one base URL + one key for many
# models, including Google Gemma 4, with automatic provider failover), so it
# reuses the "openai" provider — no separate provider or SDK is needed.
# Model IDs use a provider/model prefix to pin one deployment (e.g.
# google/gemma-4-31b-it), or a bare name (e.g. gemma-4-31b-it) to let
# Requesty route across providers. Get a key at https://www.requesty.ai.
# CHATBOT_PROVIDER=openai
# OPENAI_BASE_URL=https://router.requesty.ai/v1
# OPENAI_MODEL=google/gemma-4-31b-it
# OPENAI_API_KEY=your-requesty-api-key

# Request timeout in seconds.
CHATBOT_TIMEOUT=30

# Maximum user messages kept in conversation history.
CHATBOT_HISTORY_LIMIT=50

# Optional system prompt sent as the first message on every request when using
# CHATBOT_PROVIDER=openai. Leave empty (the default) to send no system message.
# Whitespace inside the value is preserved as-is; the offline provider ignores it.
# CHATBOT_SYSTEM_PROMPT=You are a concise, friendly assistant.
